        {
          "name": "Assign Volunteer to Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"volunteerId\": \"{{volunteerId}}\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/api/requests/{{requestId}}/volunteer",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "requests", "{{requestId}}", "volunteer"]
            },
            "description": "Assign a volunteer to a request (status changes to 'בטיפול')"
          },
          "response": []
        },
