            "url": {
              "raw": "http://localhost:3000/api/requests/{{requestId}}",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "requests", "{{requestId}}"]
            },
            "description": "Update only specific fields (partial update)"
          },
          "response": []
        },
