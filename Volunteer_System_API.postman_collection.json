              "raw": "{\n  \"firstName\": \"יוסי\",\n  \"lastName\": \"לוי\",\n  \"phone\": \"050-1234567\",\n  \"skills\": [\"גרירה\", \"חילוץ\", \"מכניקה\"]\n}"
            },
            "url": {
              "raw": "http://localhost:3000/api/volunteers",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "volunteers"]
            },
            "description": "Create a new volunteer"
          },
          "response": []
        },
        {
          "name": "Get All Volunteers",
          "request": {
            "method": "GET",
